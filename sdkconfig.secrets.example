# Скопіюй у sdkconfig.secrets (він у .gitignore) і заповни.
# Після зміни цього файлу видали sdkconfig (або зроби fullclean),
# бо значення з defaults не перезаписують уже наявний sdkconfig.
CONFIG_SVITLOBOT_WIFI_SSID="my-wifi"
CONFIG_SVITLOBOT_WIFI_PASSWORD="my-password"
CONFIG_SVITLOBOT_CHANNEL_KEY="key-from-svitlobot-chat-bot"
CONFIG_SVITLOBOT_OTA_TOKEN="long-random-string"
